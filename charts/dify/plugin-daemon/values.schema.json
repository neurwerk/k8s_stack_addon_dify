{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "frontendDify": {
      "type": "object",
      "properties": {
        "modelSync": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "projection": {"type": "object", "properties": {
              "bindings": {"type": "array", "maxItems": 256, "items": {
                "type": "object", "required": ["id", "api_path"], "additionalProperties": false,
                "properties": {
                  "id": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$"},
                  "api_path": {"type": "string", "maxLength": 128, "pattern": "^(/[a-z0-9][a-z0-9-]*)+$"}
                }
              }}
            }}
          }
        },
        "agentGateway": {
          "type": "object",
          "required": ["bindingId", "adapterImage"],
          "properties": {
            "bindingId": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$"},
            "adapterImage": {"type": "string", "pattern": "^docker.io/library/nginx:[0-9]+\\.[0-9]+\\.[0-9]+-alpine@sha256:[a-f0-9]{64}$"},
            "resources": {"type": "object"}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
